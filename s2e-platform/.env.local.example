# ============================================================
# S2E Platform - Environment Variables
# Vercel 배포 시 Settings > Environment Variables에 모두 등록
# ============================================================

# ----------------------------------------------------------
# Supabase (필수)
# https://supabase.com/dashboard > Project Settings > API
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ----------------------------------------------------------
# Thirdweb (필수 - 지갑 연동)
# https://thirdweb.com/dashboard > API Keys
# ----------------------------------------------------------
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id

# ----------------------------------------------------------
# Admin (필수 - 관리자 접근 제어)
# Supabase auth.users 테이블의 UUID를 쉼표로 구분
# ----------------------------------------------------------
ADMIN_USER_IDS=your-admin-uuid-1,your-admin-uuid-2
